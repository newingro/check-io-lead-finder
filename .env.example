# Variabili del server (su Railway: progetto → servizio → Variables).
# Non scrivere mai questi valori nel codice o in chat.

# Token del bot ricevuto da @BotFather
TELEGRAM_BOT_TOKEN=

# Connessione al database Supabase (Project Settings → Database → Connection string,
# modalità "Session pooler", con la password del database)
DATABASE_URL=

# Codice segreto di primo avvio (almeno 12 caratteri, inventato da te):
# il primo che scrive /collega CODICE diventa titolare. Funziona una volta sola.
OWNER_SETUP_CODE=

# Facoltative
TIMEZONE=Europe/Rome
SETTINGS_POLL_SECONDS=300
LINK_CODE_TTL_MINUTES=15
LOG_LEVEL=INFO

# ── Fasi 2-4 (facoltative: senza, il bot funziona ma non cerca e non analizza) ──
# Chiave Google Cloud con «Places API (New)» attiva (limitala alla sola Places API).
GOOGLE_MAPS_API_KEY=
# Prezzo in dollari per 1000 richieste dello SKU «Text Search Enterprise + Atmosphere»
# (pagina prezzi di Google Maps Platform). Serve per il conto della spesa: senza, il bot non cerca.
GOOGLE_TEXT_SEARCH_USD_PER_1000=
# Chiave API di Anthropic (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=
# Facoltative: modello Claude (predefinito claude-opus-5-5), sforzo (low|medium|high), cambio euro/dollaro (predefinito 1).
CLAUDE_MODEL=
CLAUDE_EFFORT=
EUR_PER_USD=

